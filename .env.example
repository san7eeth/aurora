# Copy to .env for local Docker Compose configuration. Do not commit .env.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
USER_NAME=Aurora User
LOG_LEVEL=INFO
LOG_JSON=true
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Set a private value before starting the optional Grafana profile.
# GRAFANA_ADMIN_PASSWORD=replace-with-a-local-password

# Optional staging overrides:
# BACKEND_PORT=18000
# FRONTEND_PORT=18080

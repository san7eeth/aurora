{
  "name": "aurora-e2e-playwright",
  "version": "1.0.0",
  "description": "Playwright E2E tests for Aurora AI Assistant",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:ui": "playwright test tests/aurora.spec.ts",
    "test:api": "playwright test tests/api.spec.ts",
    "codegen": "playwright codegen http://localhost:5173"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0"
  }
}
